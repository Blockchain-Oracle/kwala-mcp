{
  "name": "@kwala-dev/mcp",
  "version": "0.1.0",
  "description": "MCP server for Kwala Network — AI agents create, verify, deploy, and monitor blockchain automations through natural language.",
  "type": "module",
  "bin": {
    "kwala-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "build": "tsc",
    "start": "node dist/http.js"
  },
  "keywords": [
    "kwala",
    "mcp",
    "model-context-protocol",
    "blockchain",
    "automation",
    "kwalang",
    "web3",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kwala-dev/cli": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
