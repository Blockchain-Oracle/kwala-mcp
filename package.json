{
  "name": "kwala-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kwala-ai/web --filter @kwala-ai/docs -r --parallel dev",
    "dev:mcp": "pnpm --filter @kwala-ai/mcp dev",
    "dev:cli": "pnpm --filter @kwala-ai/cli dev",
    "dev:web": "pnpm --filter @kwala-ai/web dev",
    "dev:docs": "pnpm --filter @kwala-ai/docs dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
