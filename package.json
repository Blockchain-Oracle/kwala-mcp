{
  "name": "kwala-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:http & pnpm dev:web & wait",
    "dev:mcp": "pnpm --filter @kwala-dev/mcp dev",
    "dev:http": "pnpm --filter @kwala-dev/mcp dev:http",
    "dev:cli": "pnpm --filter @kwala-dev/cli dev",
    "dev:web": "pnpm --filter @kwala-dev/web dev",
    "dev:docs": "pnpm --filter @kwala-dev/docs dev",
    "start": "pnpm -r start",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
